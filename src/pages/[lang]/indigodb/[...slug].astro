---
import { render } from "astro:content";
import IndigoDocsLayout from "../../../layouts/IndigoDocsLayout.astro";
import { getTranslations } from "../../../libs/getTranslations";
import {
  SITE_LOCALES,
  SECTION_LABELS,
  getIndigoDocsForLocale,
  getCanonicalSlug,
  getPrevNext,
  type IndigoDocEntry,
} from "../../../libs/indigoDocs";

export async function getStaticPaths() {
  const paths = [];

  for (const lang of SITE_LOCALES) {
    const { docsLocale, entries, navItems, groups } =
      await getIndigoDocsForLocale(lang);

    for (const entry of entries) {
      const slug = getCanonicalSlug(entry.id);
      if (slug === "overview") continue;

      paths.push({
        params: { lang, slug },
        props: {
          entry,
          docsLocale,
          navItems,
          groups,
          slug,
        },
      });
    }
  }

  return paths;
}

interface Props {
  entry: IndigoDocEntry;
  docsLocale: "en" | "es";
  navItems: Awaited<ReturnType<typeof getIndigoDocsForLocale>>["navItems"];
  groups: Awaited<ReturnType<typeof getIndigoDocsForLocale>>["groups"];
  slug: string;
}

const lang = Astro.params.lang!;
const { entry, docsLocale, navItems, groups, slug } = Astro.props;
const t = getTranslations(lang);
const { Content, headings } = await render(entry);
const { prev, next } = getPrevNext(navItems, slug);
const sectionLabel = SECTION_LABELS[docsLocale][entry.data.section];
---

<IndigoDocsLayout
  lang={lang}
  t={t}
  title={entry.data.title}
  description={entry.data.description}
  sectionLabel={sectionLabel}
  currentSlug={slug}
  path={`indigodb/${slug}`}
  groups={groups}
  headings={headings}
  prev={prev}
  next={next}
  badge={entry.data.badge}
  runtime={entry.data.runtime}
  npmPackages={entry.data.npmPackages}
>
  <Content />
</IndigoDocsLayout>
