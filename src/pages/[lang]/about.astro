---
import { getTranslations } from "../../libs/getTranslations";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en-us" } },
    { params: { lang: "es-mx" } },
    { params: { lang: "es-es" } },
  ];
}

const lang = Astro.params.lang;
const t = getTranslations(lang);
const page = t.pages.about;
---

<Layout lang={lang} t={t} title={page.title} description={page.metaDescription}>
  <section
    class="bg-white dark:bg-[#0F1117] text-[#1a1a1a] dark:text-white pt-32 pb-20 px-6 transition-colors"
  >
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-5xl sm:text-6xl font-bold leading-tight mb-6">
        {page.title}
      </h1>
      <p class="text-lg text-gray-600 dark:text-[#B0D3D9] mb-12">
        {page.description}
      </p>
      <div
        class="text-left bg-white dark:bg-[#111317] border border-gray-200 dark:border-[#1a1d23] rounded-xl p-8"
      >
        <h2 class="text-2xl font-semibold mb-4">{page.missionTitle}</h2>
        <p class="text-gray-600 dark:text-gray-400">{page.missionBody}</p>
      </div>
    </div>
  </section>
</Layout>
