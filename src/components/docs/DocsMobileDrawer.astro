---
import type { NavGroup } from "../../libs/docsShared";
import DocsSidebarNav from "./DocsSidebarNav.astro";

interface Props {
  groups: NavGroup[];
  currentSlug: string;
  drawerLabel: string;
  closeLabel: string;
  versionBadge: string;
  brandDocsTitle?: string;
}

const {
  groups,
  currentSlug,
  drawerLabel,
  closeLabel,
  versionBadge,
  brandDocsTitle = "Autorix Docs",
} = Astro.props;
---

<dialog
  class="docs-drawer"
  id="docs-drawer"
  aria-label={drawerLabel}
>
  <div class="docs-drawer-scroller">
    <nav
      class="docs-drawer-sheet bg-white dark:bg-[#0F1117] text-gray-900 dark:text-white border-r border-gray-200 dark:border-[#1f2633] shadow-2xl"
      aria-label={drawerLabel}
    >
      <div class="flex items-center justify-between gap-3 px-4 py-3.5 border-b border-gray-200 dark:border-[#1f2633]">
        <div class="flex items-center gap-2">
          <span class="font-bold text-base tracking-tight">{brandDocsTitle}</span>
          <span class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded-full bg-[#59B0C8]/15 text-[#0e6b85] dark:text-[#7AD4EC]">
            {versionBadge}
          </span>
        </div>
        <button
          id="docs-drawer-close"
          type="button"
          autofocus
          aria-label={closeLabel}
          class="inline-flex items-center justify-center min-w-[36px] min-h-[36px] rounded-md text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-[#1C212C] transition-colors cursor-pointer"
        >
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="p-4 overflow-y-auto">
        <DocsSidebarNav groups={groups} currentSlug={currentSlug} />
      </div>
    </nav>
  </div>
</dialog>

<script>
  const drawer = document.getElementById("docs-drawer") as HTMLDialogElement | null;
  const openBtn = document.getElementById("docs-drawer-open");
  const closeBtn = document.getElementById("docs-drawer-close");
  const scroller = drawer?.querySelector<HTMLElement>(".docs-drawer-scroller");
  const sheet = drawer?.querySelector<HTMLElement>(".docs-drawer-sheet");

  if (drawer && openBtn && closeBtn && scroller && sheet) {
    const openDrawer = async () => {
      drawer.showModal();

      if (!CSS.supports("scroll-initial-target", "nearest")) {
        scroller.scrollTo({ left: scroller.offsetWidth, behavior: "instant" });
        await new Promise((resolve) =>
          requestAnimationFrame(() => requestAnimationFrame(resolve))
        );
      }

      scroller.scrollTo({ left: 0, behavior: "auto" });
    };

    const closeDrawer = () => {
      scroller.scrollTo({ left: scroller.offsetWidth, behavior: "auto" });
    };

    const onDrawerOpened = () => {
      openBtn.setAttribute("aria-expanded", "true");
    };

    const onDrawerClosed = () => {
      if (drawer.open) {
        drawer.close();
      }
      openBtn.setAttribute("aria-expanded", "false");
    };

    const visibleThreshold = 1 / Math.max(window.innerWidth, 1);

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries.at(-1);
        if (!entry) return;
        if (entry.intersectionRatio < visibleThreshold) onDrawerClosed();
        if (entry.intersectionRatio === 1) onDrawerOpened();
      },
      { root: drawer, threshold: [visibleThreshold, 1] }
    );
    observer.observe(sheet);

    // Fallback backdrop fade when scroll-driven animations are unsupported
    if (!CSS.supports("animation-timeline: scroll()")) {
      scroller.addEventListener("scroll", () => {
        const width = sheet.offsetWidth || 1;
        const ratio = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / width));
        drawer.style.setProperty("--drawer-backdrop", String(ratio));
      });
    }

    openBtn.addEventListener("click", openDrawer);
    closeBtn.addEventListener("click", closeDrawer);

    // Light-dismiss outside the sheet (preserving slide-out animation)
    drawer.addEventListener("click", (event) => {
      if (!sheet.contains(event.target as Node)) {
        closeDrawer();
      }
    });

    // Slide out cleanly on Escape
    drawer.addEventListener("cancel", (event) => {
      if (event.cancelable) {
        event.preventDefault();
        closeDrawer();
      }
    });
  }
</script>
