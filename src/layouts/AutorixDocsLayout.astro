---
import DocsShellLayout from "./DocsShellLayout.astro";
import type { Heading, NavGroup, NavItem } from "../libs/docsShared";

interface Props {
  lang: string;
  t: any;
  title: string;
  description: string;
  sectionLabel: string;
  currentSlug: string;
  path: string;
  groups: NavGroup[];
  headings: Heading[];
  prev?: NavItem;
  next?: NavItem;
  badge?: string;
  ports?: string;
  protocol?: string;
  isOverview?: boolean;
}

const {
  lang,
  t,
  title,
  description,
  sectionLabel,
  currentSlug,
  path,
  groups,
  headings,
  prev,
  next,
  badge,
  ports,
  protocol,
  isOverview = false,
} = Astro.props;

const ui = t.pages.autorix.docsUi;
const metaChips = [
  ports ? `${ui.portsLabel}: ${ports}` : undefined,
  protocol,
].filter((chip): chip is string => Boolean(chip));
---

<DocsShellLayout
  lang={lang}
  t={t}
  basePath="autorix"
  brandName="Autorix"
  brandDocsTitle="Autorix Docs"
  versionBadge="v0.2.8"
  githubRepo="https://github.com/Autorix-cl/autorix"
  quickStartPath="getting-started"
  architecturePath="architecture"
  ui={ui}
  title={title}
  description={description}
  sectionLabel={sectionLabel}
  currentSlug={currentSlug}
  path={path}
  groups={groups}
  headings={headings}
  prev={prev}
  next={next}
  badge={badge}
  metaChips={metaChips}
  isOverview={isOverview}
>
  <slot name="before-content" slot="before-content" />
  <slot />
</DocsShellLayout>
